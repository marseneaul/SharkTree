{
  "compilerOptions": {
    "target": "ES2017",            
    "module": "ESNext",            
    "lib": ["DOM", "ESNext"],      
    "strict": false,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "useDefineForClassFields": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
